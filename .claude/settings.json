{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/scripts/session-brief.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"\n## [$(date '+%Y-%m-%d %H:%M')] session | ended\" >> ${CLAUDE_PROJECT_DIR}/02-wiki/log.md"
          }
        ]
      }
    ]
  }
}
